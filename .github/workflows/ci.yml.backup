name: Userflow CI

on:
  push:
    branches: [master]
  pull_request:
  workflow_dispatch:

jobs:
  ci:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-node@v7
        with:
          node-version: 22
          cache: npm

      - name: Install
        run: npm ci
        env:
          HUSKY: 0

      - name: Lint
        run: npm run lint

      - name: Format check
        run: npm run format:check

      - name: Unit tests
        run: npm test

      - name: Build server
        run: npm run build -w server

      - name: Build client
        run: npm run build -w client

      - name: Start app
        run: npm run dev &
        env:
          RATE_LIMIT_MAX: 100

      - name: Wait for app
        run: npx --yes wait-on http://127.0.0.1:3001/health http://127.0.0.1:3002

      - name: Cypress E2E
        uses: cypress-io/github-action@v6
        with:
          working-directory: client
          install: false
          browser: chrome
